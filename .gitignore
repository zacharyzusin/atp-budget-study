# Storage hygiene: nothing large, machine-specific, or superseded goes in git.
# NOTE: git only treats '#' as a comment at the START of a line — keep patterns comment-free.

# conda envs, HF cache, lean cache, model weights, big intermediates
scratch/
# slurm-%x_%j.out/.err
logs/
# model/agent checkpoints (may live in scratch/ if large)
checkpoints/

# ---------------------------------------------------------------- results/
# results/ is bulk generated output (per-problem logs, agent checkpoints, curves) and is ignored
# wholesale, with narrow exceptions for the hand-written receipts the README cites by path.
# NOTE: ignore results/** (the contents), not results/ (the directory) — git will not descend into
# an excluded directory, so a trailing-slash pattern makes every re-include below unreachable.
results/**
!results/**/
# the per-phase result docs, and the trapped-core problem lists (only those .txt --
# a blanket !results/**/*.txt sweeps in ~800 stray marker/gate files)
!results/**/*.md
!results/trapped_cores/*.txt
# the headline numbers and provenance for the four baseline runs only
!results/baseline/*.json
!results/proofnet_baseline/*.json
!results/deepseek_minif2f_baseline/*.json
!results/deepseek_proofnet_baseline/*.json
# never the per-problem output, whatever else matches above
results/*/problems/

# ---------------------------------------------------------------- superseded / not for the repo
# The paper draft, the dated lab notebooks, and the superseded planning + narrative documents.
# All are in git history (through baa9eb9) and on the cluster; the README supersedes them.
paper/
PROGRESS.md
DECISIONS.md
SYNTHESIS.md
PROJECT_SUMMARY.md
HANDOFF.md
RESEARCH_COMPILATION.md
CALIBRATION_FINDINGS.md
PROJECT_PLAN.md
PLAN_NEXT.md
AUDIT_PLAN.md
PHASE2_PLAN.md
PHASE3_PLAN.md
# figure generation for the paper, orphaned now that paper/ is out of the repo
scripts/make_paper_figures.py
tests/test_make_paper_figures.py

# python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# env / editor
.env
.venv/
.DS_Store
.claude/settings.local.json

# keep the dir skeleton so paths exist on a fresh clone
!results/.gitkeep
!logs/.gitkeep
!checkpoints/.gitkeep

# pre-existing duplicate scaffold bundle (kept on disk, not tracked)
atp-budget-study-starter/

# transient last-submitted job-id pointers
.last_retrieval_budget_job
.last_validate_job
.last_proofnet_baseline_job
