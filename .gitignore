# storage hygiene: nothing large or machine-specific in git.
# NOTE: git only treats '#' as a comment at the START of a line — keep patterns comment-free.

# conda envs, HF cache, lean cache, model weights, big intermediates
scratch/
# slurm-%x_%j.out/.err
logs/
# metrics json, curves, per-problem logs, _vllm_endpoint.txt
results/**
# EXCEPTION: the per-phase result docs are the "receipts" every summary doc cites by path
# (results/phase1/FINDINGS.md, phase4/ALLOCATION.md, ...). They are small hand-written markdown,
# not generated bulk output, and a clone without them has dangling references everywhere.
# NOTE: ignore results/** (contents), not results/ (the dir) — git will not descend into an
# excluded directory, so a trailing-slash pattern makes the re-includes below unreachable.
!results/**/
!results/**/*.md
# Also keep the small, hand-citable numeric receipts: the headline metrics, the provenance
# manifests (git SHA / model revision / mathlib commit / Lean version per run), and the top-level
# analysis outputs. ~1 MB total. The bulk that stays ignored is the per-problem output and agent
# checkpoints under results/*/problems/, which is GB-scale.
!results/*.json
!results/*/*.json
results/*/problems/
# model/agent checkpoints (may live in scratch/ if large)
checkpoints/

# python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# env / editor
.env
.venv/
.DS_Store
.claude/settings.local.json

# keep the dir skeleton so paths exist on a fresh clone
!results/.gitkeep
!logs/.gitkeep
!checkpoints/.gitkeep

# pre-existing duplicate scaffold bundle (kept on disk, not tracked)
atp-budget-study-starter/

# transient last-submitted job-id pointer (scratch)
.last_retrieval_budget_job

.last_validate_job
.last_proofnet_baseline_job
